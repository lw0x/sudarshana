{
  "$schema": "https://sudarshana.dev/config-schema.json",
  "$comment": "Auto-generated by `sudarshana init`. Edit network domains as needed.",

  "mode": "enforce",
  "projectRoot": ".",
  "enableHoneypots": true,
  "onViolation": "log",
  "reportPath": "./.sudarshana-report.json",

  "policies": {
    "_application_": {
      "trust_level": "system",
      "env_visible": ["*"],
      "fs_read": ["*"],
      "fs_write": ["*"],
      "network": ["*"],
      "shell": ["*"]
    },
    "lodash": {
      "trust_level": "trusted",
      "env_visible": [],
      "fs_read": [],
      "fs_write": [],
      "network": [],
      "shell": []
    },
    "express": {
      "trust_level": "limited",
      "env_visible": ["PORT", "NODE_ENV", "HOST"],
      "fs_read": ["./views/*", "./public/*", "./node_modules/express/*"],
      "fs_write": [],
      "network": ["0.0.0.0"],
      "shell": []
    },
    "axios": {
      "trust_level": "limited",
      "env_visible": ["HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY"],
      "fs_read": [],
      "fs_write": [],
      "network": ["api.stripe.com", "*.amazonaws.com"],
      "shell": []
    },
    "prisma": {
      "trust_level": "limited",
      "env_visible": ["DATABASE_URL"],
      "fs_read": ["./prisma/*", "./node_modules/.prisma/*", "./node_modules/@prisma/*"],
      "fs_write": [],
      "network": ["localhost:5432"],
      "shell": []
    }
  }
}
